  "narrative": {
    "northStar": "The Field Guide",
    "overview": "SoloStack reads as a printed field guide to the one-person business. Every tool, stack and gear item is a catalogued specimen: a framed salt-white plate with a figure number, a name, a tagline, an A$ price and a verdict. Sections are saturated fields that swap as the visitor scrolls (sea, salt, ink, salt-2, coral), one idea per field.\n\nBass Strait sea-green carries the cover, deep marine ink carries the software catalogue, and a single coral does all the acting: buttons, prices, and the drenched business section. Urbanist over Figtree, with tracked uppercase captions, makes the page recognisable with its content removed. Drawn eucalyptus sprigs and one drawn mark per gear kind are the recurring devices.\n\nThe page is dense with real data (prices, verdicts, ratings) and calm in its chrome: no gradients, no decorative icon tiles, no card grids of identical shape. Scope: shipped on the homepage only; the shared tokens, header and footer carry the same palette and type across the site.",
    "keyCharacteristics": [
      "Full-bleed field colour per section; content centred at 1366px.",
      "Salt plates with a fine double frame as the only container language for specimens.",
      "Geometric sans display, grotesk text, uppercase tracked captions for catalogue data.",
      "One action colour (coral); its text-safe variant for coral type on light fields.",
      "Dotted leaders and hairline-ruled rows, as in a printed catalogue."
    ],
    "rules": [
      {
        "name": "The One Action Rule",
        "body": "Coral is the only action colour. On the coral field the primary button flips to ink with salt text; it never becomes a second hue.",
        "section": "colors"
      },
      {
        "name": "The Field Swap Rule",
        "body": "Each section owns one field colour and its paired text colour. Do not tint a field with gradients or overlay a second field inside it, except plates.",
        "section": "colors"
      },
      {
        "name": "The Coral Text Rule",
        "body": "Coral as type on a light field uses coral-text, never coral.",
        "section": "colors"
      },
      {
        "name": "The Single Weight Rule",
        "body": "Display faces have one weight (400) and font-synthesis-weight: none is set, so no faux bold appears. Text weights are capped at 700.",
        "section": "typography"
      },
      {
        "name": "The Lining Figures Rule",
        "body": "Prices and figure numbers use lining, tabular numerals.",
        "section": "typography"
      },
      {
        "name": "The Caption Is Data Rule",
        "body": "Uppercase tracked captions carry catalogue data (figure number, manufacturer, terms, notes). They are not decoration and not a lead-in above headings.",
        "section": "typography"
      },
      {
        "name": "The Plate Lift Rule",
        "body": "Only plates are lifted. Rows, chips, buttons and fields stay flat.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do give each section one field colour from sea, salt, salt-2, ink or coral, with its paired text colour.",
      "Do frame specimens as plates and give each a figure number, name, tagline, A$ price and verdict where data exists.",
      "Do use Urbanist at 400 only, Figtree at 700 or below, with lining tabular numerals for prices.",
      "Do use coral-text for coral type on light fields and keep 44px minimum touch height.",
      "Do keep focus visible: 3px outline with a 6px ink halo on dark fields, ink outline on light fields and plates."
    ],
    "donts": [
      "Don't add a second action colour or a gradient field.",
      "Don't lift anything but plates with a shadow.",
      "Don't return to identical card grids with a pill-row header; use plates and ruled catalogue rows.",
      "Don't use the old Manrope, Mulish or indigo values inside .fg surfaces.",
      "Don't claim anything the data does not back (see PRODUCT.md)."
    ]
  }
}